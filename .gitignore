# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# BibleRoot corpus — rebuilt locally with `npm run build:data`.
# The downloaded sources (~65 MB) and the compiled database (~85 MB) are
# derived artefacts, and the upstream data is meant to be fetched from source.
/data/library/
/data/sources/
/data/bibleroot.db
/data/bibleroot.db-shm
/data/bibleroot.db-wal

# Personal study destinations — copy data/resources.example.json to create it.
/data/resources.json

# Superseded UI wording, kept for reference. Not part of the app.
/copy-archive/
/edge-model-audit/

# Working notes for whoever maintains this. Local only.
/CLAUDE.md
/docs/HANDOFF.md
/docs/WORKLOG.md
